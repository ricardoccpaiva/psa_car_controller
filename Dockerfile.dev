# Development Dockerfile for PSA Car Controller Backend
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY pyproject.toml .
COPY psa_car_controller ./psa_car_controller

# Install Python dependencies
RUN pip install --upgrade pip && \
    pip install poetry && \
    poetry config virtualenvs.create false && \
    poetry install --no-dev

# Expose Flask port
EXPOSE 5000

# Set environment variables
ENV PYTHONPATH=/app
ENV FLASK_APP=psa_car_controller.web.app_new
ENV FLASK_ENV=development

# Run the application with web-conf flag to allow starting without full config
CMD ["python", "-m", "psa_car_controller", "--web-conf", "-l", "0.0.0.0", "-p", "5000"]
